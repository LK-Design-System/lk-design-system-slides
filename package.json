    "@lk-robotics/lds-product": "file:vendor/lk-robotics-lds-product-0.1.0-rc.3.tgz"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "devDependencies": {
    "@lk-robotics/lds-theme": "file:vendor/lk-robotics-lds-theme-0.1.0-rc.3.tgz",
    "@playwright/test": "1.61.1",
    "@storybook/addon-a11y": "10.4.6",
    "@storybook/addon-docs": "10.4.6",
    "@storybook/react-vite": "10.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "storybook": "10.4.6",
    "vite": "8.1.3"
  },
  "publishConfig": {
