{
  "name": "@lk-robotics/lds-slides-ui",
  "version": "0.1.0-alpha.1",
  "description": "Presentation slide surface, layout, and deck presentation layer for LDS.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.js",
  "module": "./src/index.js",
  "files": [
    "src",
    "styles.css",
    "tokens",
    "vendor"
  ],
  "sideEffects": [
    "*.css",
